<?xml version="1.0" encoding="utf-8"?>
<!-- Home screen widget: an add button, then up to three templates. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="6dp">

    <TextView
        android:id="@+id/widget_add"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:background="@drawable/widget_button_primary"
        android:drawableStart="@drawable/ic_add"
        android:drawablePadding="6dp"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:paddingStart="12dp"
        android:paddingEnd="14dp"
        android:text="@string/add_transaction_short"
        android:textColor="#FFFFFF"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/widget_template_1"
        style="@style/WidgetTemplate"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_template_2"
        style="@style/WidgetTemplate"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_template_3"
        style="@style/WidgetTemplate"
        android:visibility="gone" />
</LinearLayout>
